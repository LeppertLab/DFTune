{
  "name": "project-electrons",
  "displayName": "Project Electrons: VASP INCAR Builder",
  "description": "Set up VASP calculations by physical intent instead of raw INCAR tags. Works on remote HPC files over Remote-SSH.",
  "version": "0.4.0",
  "publisher": "project-electrons",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LeppertLab/project-electrons"
  },
  "homepage": "https://github.com/LeppertLab/project-electrons#readme",
  "bugs": {
    "url": "https://github.com/LeppertLab/project-electrons/issues"
  },
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "VASP",
    "DFT",
    "INCAR",
    "HPC",
    "materials"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "incar",
        "aliases": [
          "INCAR",
          "VASP INCAR"
        ],
        "filenames": [
          "INCAR"
        ],
        "filenamePatterns": [
          "INCAR.*",
          "INCAR_*",
          "*.incar"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "incar",
        "scopeName": "source.incar",
        "path": "./syntaxes/incar.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "projectElectrons.incarBuilder",
        "displayName": "INCAR Builder",
        "selector": [
          {
            "filenamePattern": "INCAR"
          },
          {
            "filenamePattern": "INCAR.*"
          },
          {
            "filenamePattern": "INCAR_*"
          },
          {
            "filenamePattern": "*.incar"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "projectElectrons.openBuilder",
        "title": "Open INCAR Builder",
        "category": "VASP",
        "icon": "$(settings)"
      },
      {
        "command": "projectElectrons.newCalculation",
        "title": "New VASP Calculation…",
        "category": "VASP"
      }
    ],
    "configuration": {
      "title": "VASP INCAR",
      "properties": {
        "projectElectrons.format.groupByCategory": {
          "type": "boolean",
          "default": true,
          "description": "Format Document: sort tags into categories (General, Electronic minimization, …). Off keeps the file order."
        },
        "projectElectrons.format.categoryHeaders": {
          "type": "boolean",
          "default": true,
          "description": "Format Document: write a `# Category` comment above each group. A hand-written heading on the same topic is kept instead."
        },
        "projectElectrons.format.alignEquals": {
          "type": "boolean",
          "default": true,
          "description": "Format Document: line up the `=` signs within a group."
        },
        "projectElectrons.format.alignComments": {
          "type": "boolean",
          "default": true,
          "description": "Format Document: line up trailing comments within a group."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "projectElectrons.openBuilder",
          "when": "editorLangId == incar",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "projectElectrons.newCalculation",
          "when": "explorerResourceIsFolder",
          "group": "navigation@90"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "npm run build -- --production && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
