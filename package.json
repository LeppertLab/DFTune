{
  "name": "dftune",
  "displayName": "DFTune: DFT Input Builder",
  "description": "Set up DFT calculations by physical intent instead of raw input tags. VASP: INCAR builder, plus checks, hovers, quick fixes and formatting for INCAR, KPOINTS and POSCAR. Quantum ESPRESSO: builder, checks, hovers, completion, formatting and conversion for pw.x, ph.x, dos.x, projwfc.x, bands.x and pp.x inputs. Works on remote HPC files over Remote-SSH.",
  "version": "3.0.1",
  "publisher": "DaanHolleman",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LeppertLab/DFTune"
  },
  "homepage": "https://github.com/LeppertLab/DFTune#readme",
  "bugs": {
    "url": "https://github.com/LeppertLab/DFTune/issues"
  },
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "VASP",
    "DFT",
    "INCAR",
    "KPOINTS",
    "POSCAR",
    "HPC",
    "materials",
    "Quantum ESPRESSO",
    "DFTune",
    "pw.x",
    "BerkeleyGW",
    "GW",
    "BSE"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "incar",
        "aliases": [
          "INCAR",
          "VASP INCAR"
        ],
        "filenames": [
          "INCAR"
        ],
        "filenamePatterns": [
          "INCAR.*",
          "INCAR_*",
          "*.incar"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "kpoints",
        "aliases": [
          "KPOINTS",
          "VASP KPOINTS"
        ],
        "filenames": [
          "KPOINTS"
        ],
        "filenamePatterns": [
          "KPOINTS.*",
          "KPOINTS_*",
          "*.kpoints"
        ],
        "configuration": "./positional-language-configuration.json"
      },
      {
        "id": "poscar",
        "aliases": [
          "POSCAR",
          "VASP POSCAR",
          "CONTCAR"
        ],
        "filenames": [
          "POSCAR",
          "CONTCAR"
        ],
        "filenamePatterns": [
          "POSCAR.*",
          "POSCAR_*",
          "CONTCAR.*",
          "CONTCAR_*",
          "*.vasp",
          "*.poscar"
        ],
        "configuration": "./positional-language-configuration.json"
      },
      {
        "id": "qe",
        "aliases": [
          "Quantum ESPRESSO",
          "QE input"
        ],
        "filenamePatterns": [
          "*.pwi",
          "*.pw.in",
          "pw.*.in",
          "pw_*.in",
          "scf.in",
          "scf.*.in",
          "nscf.in",
          "relax.in",
          "vc-relax.in",
          "bands.in",
          "ph.in",
          "dos.in",
          "projwfc.in",
          "pp.in",
          "pw2bgw.in",
          "pw2bgw.inp",
          "*.phi"
        ],
        "firstLine": "^\\s*&\\s*(?:[Cc][Oo][Nn][Tt][Rr][Oo][Ll]|[Ii][Nn][Pp][Uu][Tt][Pp][Hh]|[Pp][Rr][Oo][Jj][Ww][Ff][Cc]|[Dd][Oo][Ss]|[Bb][Aa][Nn][Dd][Ss]|[Ii][Nn][Pp][Uu][Tt][Pp][Pp]|[Pp][Ll][Oo][Tt]|[Ii][Nn][Pp][Uu][Tt]_[Pp][Ww]2[Bb][Gg][Ww])\\b",
        "configuration": "./qe-language-configuration.json"
      },
      {
        "id": "qe-plot",
        "aliases": [
          "QE plotband/plotrho input"
        ],
        "filenamePatterns": [
          "plotband.in",
          "plotrho.in",
          "plotband*.in",
          "plotrho*.in",
          "*.plotband",
          "*.plotrho"
        ],
        "configuration": "./positional-language-configuration.json"
      },
      {
        "id": "bgw",
        "aliases": [
          "BerkeleyGW",
          "BerkeleyGW input"
        ],
        "filenamePatterns": [
          "epsilon.inp",
          "epsilon*.inp",
          "sigma.inp",
          "sigma*.inp",
          "kernel.inp",
          "kernel*.inp",
          "absorption.inp",
          "absorption*.inp",
          "inteqp.inp",
          "inteqp*.inp",
          "eps_*.inp",
          "sig_*.inp",
          "absp_*.inp"
        ],
        "configuration": "./bgw-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "incar",
        "scopeName": "source.incar",
        "path": "./syntaxes/incar.tmLanguage.json"
      },
      {
        "language": "kpoints",
        "scopeName": "source.kpoints",
        "path": "./syntaxes/kpoints.tmLanguage.json"
      },
      {
        "language": "poscar",
        "scopeName": "source.poscar",
        "path": "./syntaxes/poscar.tmLanguage.json"
      },
      {
        "language": "qe",
        "scopeName": "source.qe",
        "path": "./syntaxes/qe.tmLanguage.json"
      },
      {
        "language": "bgw",
        "scopeName": "source.bgw",
        "path": "./syntaxes/bgw.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "dftune.incarBuilder",
        "displayName": "INCAR Builder",
        "selector": [
          {
            "filenamePattern": "INCAR"
          },
          {
            "filenamePattern": "INCAR.*"
          },
          {
            "filenamePattern": "INCAR_*"
          },
          {
            "filenamePattern": "*.incar"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "dftune.qeBuilder",
        "displayName": "Quantum ESPRESSO Builder",
        "selector": [
          {
            "filenamePattern": "*.pwi"
          },
          {
            "filenamePattern": "*.pw.in"
          },
          {
            "filenamePattern": "pw.*.in"
          },
          {
            "filenamePattern": "scf.in"
          },
          {
            "filenamePattern": "nscf.in"
          },
          {
            "filenamePattern": "relax.in"
          },
          {
            "filenamePattern": "vc-relax.in"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "dftune.bgwBuilder",
        "displayName": "BerkeleyGW Builder",
        "selector": [
          {
            "filenamePattern": "epsilon.inp"
          },
          {
            "filenamePattern": "sigma.inp"
          },
          {
            "filenamePattern": "kernel.inp"
          },
          {
            "filenamePattern": "absorption.inp"
          },
          {
            "filenamePattern": "inteqp.inp"
          },
          {
            "filenamePattern": "eps_*.inp"
          },
          {
            "filenamePattern": "sig_*.inp"
          },
          {
            "filenamePattern": "absp_*.inp"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "dftune.openBuilder",
        "title": "Open INCAR Builder",
        "category": "VASP",
        "icon": "$(settings)"
      },
      {
        "command": "dftune.openQeBuilder",
        "title": "Open Quantum ESPRESSO Builder",
        "category": "DFTune",
        "icon": "$(settings)"
      },
      {
        "command": "dftune.openBgwBuilder",
        "title": "Open BerkeleyGW Builder",
        "category": "DFTune",
        "icon": "$(settings)"
      },
      {
        "command": "dftune.newCalculation",
        "title": "New VASP Calculation…",
        "category": "VASP"
      },
      {
        "command": "dftune.generateKpoints",
        "title": "Generate k-point Mesh…",
        "category": "VASP"
      },
      {
        "command": "dftune.poscarToQe",
        "title": "Create Quantum ESPRESSO Input from POSCAR…",
        "category": "DFTune"
      },
      {
        "command": "dftune.qeToPoscar",
        "title": "Create POSCAR from Quantum ESPRESSO Input",
        "category": "DFTune"
      }
    ],
    "configuration": {
      "title": "DFTune",
      "properties": {
        "dftune.format.groupByCategory": {
          "type": "boolean",
          "default": true,
          "description": "Format Document: sort tags into categories (General, Electronic minimization, …). Off keeps the file order."
        },
        "dftune.format.categoryHeaders": {
          "type": "boolean",
          "default": true,
          "description": "Format Document: write a `# Category` comment above each group. A hand-written heading on the same topic is kept instead."
        },
        "dftune.format.alignEquals": {
          "type": "boolean",
          "default": true,
          "description": "Format Document: line up the `=` signs within a group."
        },
        "dftune.format.alignComments": {
          "type": "boolean",
          "default": true,
          "description": "Format Document: line up trailing comments within a group."
        },
        "dftune.format.logicals": {
          "type": "string",
          "enum": [
            ".TRUE.",
            "T",
            "keep"
          ],
          "enumDescriptions": [
            "Write .TRUE. and .FALSE.",
            "Write T and F",
            "Keep each value as written"
          ],
          "default": ".TRUE.",
          "description": "Format Document: spelling of true/false values of logical tags (T, .t., True, .TRUE., … all mean the same to VASP)."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "dftune.openBuilder",
          "when": "editorLangId == incar",
          "group": "navigation"
        },
        {
          "command": "dftune.openQeBuilder",
          "when": "editorLangId == qe",
          "group": "navigation"
        },
        {
          "command": "dftune.openBgwBuilder",
          "when": "editorLangId == bgw",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "dftune.newCalculation",
          "when": "explorerResourceIsFolder",
          "group": "navigation@90"
        },
        {
          "command": "dftune.generateKpoints",
          "when": "explorerResourceIsFolder || resourceLangId =~ /^(incar|poscar|kpoints|qe)$/",
          "group": "navigation@91"
        },
        {
          "command": "dftune.poscarToQe",
          "when": "resourceLangId == poscar",
          "group": "navigation@92"
        },
        {
          "command": "dftune.qeToPoscar",
          "when": "resourceLangId == qe",
          "group": "navigation@92"
        }
      ],
      "editor/context": [
        {
          "command": "dftune.generateKpoints",
          "when": "editorLangId =~ /^(incar|poscar|kpoints|qe)$/",
          "group": "1_modification@90"
        },
        {
          "command": "dftune.poscarToQe",
          "when": "editorLangId == poscar",
          "group": "1_modification@91"
        },
        {
          "command": "dftune.qeToPoscar",
          "when": "editorLangId == qe",
          "group": "1_modification@91"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node test/harness/smoke.cjs",
    "package": "npm run build -- --production && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
