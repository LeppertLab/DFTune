{
  "name": "dftune",
  "displayName": "DFTune: DFT Input Builder",
  "description": "Set up DFT calculations by physical intent instead of raw input tags. VASP: INCAR builder, plus checks, hovers, quick fixes and formatting for INCAR, KPOINTS and POSCAR. Quantum ESPRESSO: checks, hovers and completion for pw.x inputs. Works on remote HPC files over Remote-SSH.",
  "version": "1.1.0",
  "publisher": "DaanHolleman",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LeppertLab/DFTune"
  },
  "homepage": "https://github.com/LeppertLab/DFTune#readme",
  "bugs": {
    "url": "https://github.com/LeppertLab/DFTune/issues"
  },
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "VASP",
    "DFT",
    "INCAR",
    "KPOINTS",
    "POSCAR",
    "HPC",
    "materials",
    "Quantum ESPRESSO",
    "DFTune",
    "pw.x"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "incar",
        "aliases": [
          "INCAR",
          "VASP INCAR"
        ],
        "filenames": [
          "INCAR"
        ],
        "filenamePatterns": [
          "INCAR.*",
          "INCAR_*",
          "*.incar"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "kpoints",
        "aliases": [
          "KPOINTS",
          "VASP KPOINTS"
        ],
        "filenames": [
          "KPOINTS"
        ],
        "filenamePatterns": [
          "KPOINTS.*",
          "KPOINTS_*",
          "*.kpoints"
        ],
        "configuration": "./positional-language-configuration.json"
      },
      {
        "id": "poscar",
        "aliases": [
          "POSCAR",
          "VASP POSCAR",
          "CONTCAR"
        ],
        "filenames": [
          "POSCAR",
          "CONTCAR"
        ],
        "filenamePatterns": [
          "POSCAR.*",
          "POSCAR_*",
          "CONTCAR.*",
          "CONTCAR_*",
          "*.vasp",
          "*.poscar"
        ],
        "configuration": "./positional-language-configuration.json"
      },
      {
        "id": "qe",
        "aliases": [
          "Quantum ESPRESSO",
          "QE input"
        ],
        "filenamePatterns": [
          "*.pwi",
          "*.pw.in",
          "pw.*.in",
          "pw_*.in",
          "scf.in",
          "scf.*.in",
          "nscf.in",
          "relax.in",
          "vc-relax.in",
          "bands.in",
          "ph.in",
          "dos.in",
          "projwfc.in",
          "pp.in",
          "*.phi"
        ],
        "firstLine": "^\\s*&\\s*(?:[Cc][Oo][Nn][Tt][Rr][Oo][Ll]|[Ii][Nn][Pp][Uu][Tt][Pp][Hh]|[Pp][Rr][Oo][Jj][Ww][Ff][Cc]|[Dd][Oo][Ss]|[Bb][Aa][Nn][Dd][Ss]|[Ii][Nn][Pp][Uu][Tt][Pp][Pp]|[Pp][Ll][Oo][Tt])\\b",
        "configuration": "./qe-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "incar",
        "scopeName": "source.incar",
        "path": "./syntaxes/incar.tmLanguage.json"
      },
      {
        "language": "kpoints",
        "scopeName": "source.kpoints",
        "path": "./syntaxes/kpoints.tmLanguage.json"
      },
      {
        "language": "poscar",
        "scopeName": "source.poscar",
        "path": "./syntaxes/poscar.tmLanguage.json"
      },
      {
        "language": "qe",
        "scopeName": "source.qe",
        "path": "./syntaxes/qe.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "dftune.incarBuilder",
        "displayName": "INCAR Builder",
        "selector": [
          {
            "filenamePattern": "INCAR"
          },
          {
            "filenamePattern": "INCAR.*"
          },
          {
            "filenamePattern": "INCAR_*"
          },
          {
            "filenamePattern": "*.incar"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "dftune.openBuilder",
        "title": "Open INCAR Builder",
        "category": "VASP",
        "icon": "$(settings)"
      },
      {
        "command": "dftune.newCalculation",
        "title": "New VASP Calculation…",
        "category": "VASP"
      },
      {
        "command": "dftune.generateKpoints",
        "title": "Generate KPOINTS Mesh…",
        "category": "VASP"
      }
    ],
    "configuration": {
      "title": "DFTune",
      "properties": {
        "dftune.format.groupByCategory": {
          "type": "boolean",
          "default": true,
          "description": "Format Document: sort tags into categories (General, Electronic minimization, …). Off keeps the file order."
        },
        "dftune.format.categoryHeaders": {
          "type": "boolean",
          "default": true,
          "description": "Format Document: write a `# Category` comment above each group. A hand-written heading on the same topic is kept instead."
        },
        "dftune.format.alignEquals": {
          "type": "boolean",
          "default": true,
          "description": "Format Document: line up the `=` signs within a group."
        },
        "dftune.format.alignComments": {
          "type": "boolean",
          "default": true,
          "description": "Format Document: line up trailing comments within a group."
        },
        "dftune.format.logicals": {
          "type": "string",
          "enum": [
            ".TRUE.",
            "T",
            "keep"
          ],
          "enumDescriptions": [
            "Write .TRUE. and .FALSE.",
            "Write T and F",
            "Keep each value as written"
          ],
          "default": ".TRUE.",
          "description": "Format Document: spelling of true/false values of logical tags (T, .t., True, .TRUE., … all mean the same to VASP)."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "dftune.openBuilder",
          "when": "editorLangId == incar",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "dftune.newCalculation",
          "when": "explorerResourceIsFolder",
          "group": "navigation@90"
        },
        {
          "command": "dftune.generateKpoints",
          "when": "explorerResourceIsFolder || resourceLangId =~ /^(incar|poscar|kpoints)$/",
          "group": "navigation@91"
        }
      ],
      "editor/context": [
        {
          "command": "dftune.generateKpoints",
          "when": "editorLangId =~ /^(incar|poscar|kpoints)$/",
          "group": "1_modification@90"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node test/harness/smoke.cjs",
    "package": "npm run build -- --production && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
