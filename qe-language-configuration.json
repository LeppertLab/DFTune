{
  "comments": {
    "lineComment": "!"
  },
  "brackets": [["(", ")"], ["{", "}"]],
  "autoClosingPairs": [
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "(", "close": ")" },
    { "open": "{", "close": "}" }
  ],
  "wordPattern": "[A-Za-z0-9_.+\\-*]+"
}
