{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MolGW input",
  "scopeName": "source.molgw",
  "patterns": [
    { "name": "comment.line.exclamation.molgw", "match": "!.*$" },
    { "name": "invalid.deprecated.comment.molgw", "match": "^\\s*#.*$" },
    { "name": "entity.name.namespace.molgw", "match": "(?i)^\\s*&\\s*molgw\\b" },
    { "name": "punctuation.section.group.end.molgw", "match": "^\\s*(?:/|&end\\b)" },
    {
      "match": "(?<![\\w.])([A-Za-z_]\\w*(?:\\s*\\([^)]*\\))?)\\s*(=)",
      "captures": {
        "1": { "name": "variable.other.keyword.molgw" },
        "2": { "name": "keyword.operator.assignment.molgw" }
      }
    },
    { "name": "string.quoted.single.molgw", "begin": "'", "end": "'|$", "patterns": [{ "match": "''" }] },
    { "name": "string.quoted.double.molgw", "begin": "\"", "end": "\"|$", "patterns": [{ "match": "\"\"" }] },
    {
      "match": "^\\s*([A-Z][a-z]?|\\d{1,3})(?=[\\s,]+[+-]?(?:\\d|\\.\\d))",
      "captures": { "1": { "name": "entity.name.tag.element.molgw" } }
    },
    {
      "name": "constant.numeric.molgw",
      "match": "(?<![\\w.])[+-]?(?:\\d+\\.?\\d*|\\.\\d+)(?:[eEdDqQ][+-]?\\d+)?(?![\\w.])"
    }
  ]
}
