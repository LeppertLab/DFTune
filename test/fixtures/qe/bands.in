&CONTROL
  calculation = 'bands'
  prefix = 'si'
  outdir = './tmp'
  pseudo_dir = './pseudo'
  verbosity = 'high'
/
&SYSTEM
  ibrav = 2, celldm(1) = 10.2, nat = 2, ntyp = 1, ecutwfc = 25.0, nbnd = 8
/
&ELECTRONS
  conv_thr = 1.0d-10
/
ATOMIC_SPECIES
  Si 28.0855 Si.pz-vbc.UPF
ATOMIC_POSITIONS {alat}
  Si 0.00 0.00 0.00
  Si 0.25 0.25 0.25
K_POINTS {tpiba_b}
4
  gG  20
  X   10
  W   10
  gG   1
