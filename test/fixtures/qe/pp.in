&INPUTPP
  prefix = 'si'
  outdir = './tmp'
  filplot = 'si.rho'
  plot_num = 0
/
&PLOT
  nfile = 1
  filepp(1) = 'si.rho'
  weight(1) = 1.0
  iflag = 2
  output_format = 3
  fileout = 'si.rho.dat'
  e1(1) = 1.0, e1(2) = 0.0, e1(3) = 0.0
  e2(1) = 0.0, e2(2) = 1.0, e2(3) = 0.0
  x0(1) = 0.0, x0(2) = 0.0, x0(3) = 0.0
  nx = 100, ny = 100
/
